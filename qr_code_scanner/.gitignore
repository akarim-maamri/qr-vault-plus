# Built application files
*.apk
*.aab
*.ap_

# Files for the ART/Dalvik VM
*.dex

# Java class files
*.class

# Generated files
bin/
gen/
out/
release/

# Gradle files
.gradle/
build/
**/build/

# Local configuration file (contains SDK path and should not be checked in)
local.properties

# Google Services (DO NOT COMMIT - contains API keys)
google-services.json

# Proguard folder generated by Eclipse
proguard/

# Log Files
*.log
hs_err_pid*.log
replay_pid*.log

# Android Studio Navigation editor temp files
.navigation/

# Android Studio captures folder
captures/

# IntelliJ
*.iml
.idea/
.idea/workspace.xml
.idea/tasks.xml
.idea/gradle.xml
.idea/assetWizardSettings.xml
.idea/dictionaries
.idea/libraries
.idea/caches

# Keystore files (NEVER COMMIT)
*.jks
*.keystore

# External native build folder generated in Android Studio 2.2 and later
.externalNativeBuild
.cxx/

# GooglePlayServices
.google/

# Scratch files
check.kts
check.py
