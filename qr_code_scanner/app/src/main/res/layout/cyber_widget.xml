<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_neon"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="12dp">

    <!-- Brand Column -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.3"
        android:orientation="vertical"
        android:paddingStart="4dp">
        
        <TextView
            android:id="@+id/widget_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="QR"
            android:textColor="#00F2FE"
            android:textStyle="bold"
            android:textSize="14sp" />
            
        <TextView
            android:id="@+id/widget_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="VAULT+"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Vertical Line Separator -->
    <ImageView
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:background="#262626"
        android:layout_marginLeft="6dp"
        android:layout_marginRight="6dp" />

    <!-- Actions Row -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="3.7"
        android:orientation="horizontal"
        android:gravity="center">

        <!-- Quick Scan Button -->
        <LinearLayout
            android:id="@+id/btn_widget_scan"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:background="@android:color/transparent"
            android:gravity="center"
            android:orientation="vertical">
            
            <ImageView
                android:id="@+id/btn_widget_scan_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@android:drawable/ic_menu_camera" />
                
            <TextView
                android:id="@+id/tv_widget_scan"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SCAN"
                android:textColor="#88FFFFFF"
                android:textSize="9sp"
                android:textStyle="bold"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- Generate Button -->
        <LinearLayout
            android:id="@+id/btn_widget_generate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:background="@android:color/transparent"
            android:gravity="center"
            android:orientation="vertical">
            
            <ImageView
                android:id="@+id/btn_widget_generate_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@android:drawable/ic_menu_add" />
                
            <TextView
                android:id="@+id/tv_widget_generate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CREATE"
                android:textColor="#88FFFFFF"
                android:textSize="9sp"
                android:textStyle="bold"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- Cyber-Vault Button -->
        <LinearLayout
            android:id="@+id/btn_widget_vault"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:background="@android:color/transparent"
            android:gravity="center"
            android:orientation="vertical">
            
            <ImageView
                android:id="@+id/btn_widget_vault_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@android:drawable/ic_lock_idle_lock" />
                
            <TextView
                android:id="@+id/tv_widget_vault"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="VAULT"
                android:textColor="#88FFFFFF"
                android:textSize="9sp"
                android:textStyle="bold"
                android:layout_marginTop="2dp" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
